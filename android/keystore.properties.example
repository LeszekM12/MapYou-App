# ─── SZABLON — skopiuj jako `keystore.properties` i uzupelnij ────────────────
# Ten plik (bez `.example`) JEST w .gitignore i nigdy nie trafia do repo.
#
# Sciezka moze byc wzgledna do katalogu `android/` albo bezwzgledna.
# W Windows uzywaj ukosnikow w przod albo podwojnych wstecznych:
#   storeFile=C:/Users/Lesze/keystore/mapyou-release.jks
storeFile=../mapyou-release.jks
storePassword=TWOJE_HASLO_DO_KEYSTORE
keyAlias=mapyou
keyPassword=TWOJE_HASLO_DO_KLUCZA
