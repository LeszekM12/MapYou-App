{
  "name": "mapty-ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "http-server .",
    "vendor": "node scripts/vendor.mjs",
    "build:app": "node scripts/vendor.mjs && tsc && node scripts/assemble-www.mjs && node scripts/bundle-app.mjs",
    "android": "npm run build:app && npx cap copy android && npx cap open android",
    "android:patch": "node scripts/patch-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/leaflet": "^1.9.0",
    "esbuild": "^0.28.1",
    "http-server": "^14.1.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/app-check": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "capacitor-health": "^8.1.2",
    "capacitor-live-activities": "^8.0.0",
    "chart.js": "4.4.0",
    "dexie": "3.2.7",
    "firebase": "^12.16.0",
    "jszip": "3.10.1",
    "leaflet": "1.6.0",
    "leaflet.markercluster": "1.5.3",
    "libsodium-wrappers": "0.7.15"
  }
}
